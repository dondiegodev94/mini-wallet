# ==========================================
# ⚙️ ENTORNOS Y CONFIGURACIÓN - MINI WALLET
# ==========================================

# --- 1. CONFIGURACIÓN DE LA APLICACIÓN (UI) ---
# URL base para las peticiones al BFF (Backend For Frontend)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Tiempo máximo de espera para abortar peticiones colgadas (Timeout) en milisegundos
NEXT_PUBLIC_TIMEOUT_MS="4000"

# --- 2. CONFIGURACIÓN DE SEGURIDAD Y SESIÓN (BFF) ---
# Secreto para firmar/encriptar la cookie de sesión (Mock Auth)
SESSION_SECRET="super-secret-key-para-desarrollo-local-min-32-chars"

# --- 3. ENTORNO DE PRUEBAS Y ALEATORIEDAD ---
# Habilita o deshabilita el bypass de aleatoriedad. 
# Si es "true", la API aceptará el header `x-mock-scenario`. 
# En un entorno de producción real, esto SIEMPRE debe ser "false".
ENABLE_TEST_SCENARIOS="true"

# --- 4. OBSERVABILIDAD Y ANALÍTICA (FUTURO) ---
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN="tu-token-datadog"
# NEXT_PUBLIC_DATADOG_APP_ID="tu-app-id-datadog"
# NEXT_PUBLIC_MIXPANEL_TOKEN="tu-token-mixpanel"
